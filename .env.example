# Copy to .env (gitignored) in the repo root, next to docker-compose.yml, and fill in real values:
#   cp .env.example .env
# Upgrading an existing stack (or on Windows/PowerShell)? Read UPGRADE.md first.
# docker compose reads .env automatically for ${VAR} substitution.
# Never commit .env or real passwords.
#
# --- Required (FP-28) -------------------------------------------------------
# Database password, used by the postgres container (POSTGRES_PASSWORD) and the backend.
# Postgres applies it ONLY when the data volume is first created. If you already ran this stack
# before (volume pgdata-local exists), it was created with the old built-in password ai123, so either:
#   a) keep your data: set DB_PASSWORD=ai123 here, or change it in the database first:
#        docker compose exec postgres psql -U ai -d ai -c "ALTER USER ai PASSWORD 'new-password'"
#      and then put the new password here; or
#   b) start fresh (DELETES ALL DATA): docker compose down -v
# For a brand-new volume choose any strong password, e.g. openssl rand -base64 24
DB_PASSWORD=change-me

# JWT signing key, at least 32 bytes. Generate 48 random bytes, base64-encoded, and write them as
#   JWT_SECRET=base64:<output>
# with:  openssl rand -base64 48
# or in PowerShell 7+:  [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# (Windows PowerShell 5.1: see UPGRADE.md). Without the "base64:" prefix the value is used as a raw string.
# docker compose refuses to start while it is unset; the backend refuses a key that is too short,
# contains "change-me" or is the old built-in key (also when given as base64:).
# Changing the key logs everyone out (old tokens become invalid).
JWT_SECRET=change-me

# --- Optional startup seeding ------------------------------------------------
# Optional startup seeding by the backend's ProdDataSeeder (prod profile).
# A user is created only when BOTH its email and a real password are set (the
# placeholder "change-me" is rejected); leave a pair
# empty (or delete .env) to seed nothing. Passwords are never logged, and an
# existing user's password is never changed by the seeder.

# Admin user (role ADMIN)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Demo user (role USER) plus demo profile, analyses, roadmap and training data
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=change-me
